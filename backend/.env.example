# For local backend-only development. Root .env is used by Docker Compose.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./devopspilot.db
JWT_SECRET=change-this-local-secret
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CONTROLLER_URL=http://localhost:8002
CONTROLLER_TOKEN=change_me_controller_token
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
JAEGER_URL=http://localhost:16686
MONITORED_API_URL=http://localhost:8001
ALLOWED_DEMO_CONTAINERS=demo-postgres,cpu-stressor,memory-stressor
CORS_ORIGINS=http://localhost:5173
