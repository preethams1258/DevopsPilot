# Copy this file to .env before running Docker Compose.
ENVIRONMENT=development
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CONTROLLER_TOKEN=replace-with-a-different-long-random-token
PLATFORM_DB_PASSWORD=replace_platform_password
DEMO_DB_PASSWORD=replace_demo_password
GRAFANA_PASSWORD=replace_grafana_password
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CORS_ORIGINS=http://localhost:5173
ALLOWED_DEMO_CONTAINERS=demo-postgres,cpu-stressor,memory-stressor
